# Local development environment.
#
# Copy to `.env` (which is gitignored) and adjust if a port is already taken:
#   cp .env.example .env
#
# `pnpm dev` reads this file and passes the values to every service it starts.
# Nothing here reaches Replit — production still gets its values from the
# deployment environment.

# ── Database ──────────────────────────────────────────────────────────────────
# Points at the Postgres container defined in docker-compose.yml.
DATABASE_URL=postgresql://mindcanvas:mindcanvas@localhost:5432/mindcanvas
DB_PORT=5432

# ── Service ports ─────────────────────────────────────────────────────────────
# These match the ports each artifact uses in production (.replit-artifact/
# artifact.toml) so local and deployed behave identically.
API_PORT=8080
WEB_PORT=22107
MOBILE_PORT=18991

# ── Mobile ────────────────────────────────────────────────────────────────────
# The address a phone or emulator uses to reach the API server on this machine.
# Leave blank to auto-detect this machine's LAN IP, or set it explicitly:
#   physical device (Expo Go)  → this machine's LAN IP, e.g. 192.168.0.134
#   Android emulator           → 10.0.2.2
#   iOS simulator              → localhost
LOCAL_LAN_IP=

# ── /api/map auth (M10, optional) ───────────────────────────────────────────────
# /api/map is otherwise unauthenticated with open CORS and a single shared row —
# anyone who can reach the server can read and overwrite the map. Leave these
# blank to keep the current open behavior (the default, and what local dev uses
# unless you're specifically testing this). To require a bearer token, set the
# SAME value in all three — the server checks it, both clients send it:
#   MAP_API_TOKEN=<any-string>          (dev-local.ts passes this to the API)
#   VITE_MAP_API_TOKEN=<same-string>    (baked into the web bundle at build time)
#   EXPO_PUBLIC_MAP_API_TOKEN=<same-string>  (baked into the mobile bundle)
# Since both clients are static bundles with no login system, this is a shared
# secret that deters someone stumbling onto the deployed URL — not a defense
# against someone who already has legitimate access to run the app.
MAP_API_TOKEN=
VITE_MAP_API_TOKEN=
EXPO_PUBLIC_MAP_API_TOKEN=
